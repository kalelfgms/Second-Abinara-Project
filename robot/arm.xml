<mujoco model="arm">
    <compiler angle="degree"/>
    <option 
    gravity="0 0 0"
    timestep="0.025"
    />

    <worldbody>
        <light pos="0 0 2" dir="0 0 -1"/>
        <geom type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"/>

        <body name="baselink" pos="0 0 0.05">
            <geom type="box" size=".1 .1 .05" rgba="0.75 0.75 0.75 1"/>

            <!-- torso, yaw -->
            <body name="torso" pos="0 0 0.05">
                <joint name="torso_bodylink" type="hinge" pos="0 0 0" axis="0 0 1" range="-180 180"/>
                <geom type="box" size=".03 .015 .06" pos="0 0 0.06" rgba="0.75 0.75 0.75 1"/>
                <geom type="cylinder" size = "0.06 0.02" pos="0 0 0" rgba="0.6 0.6 0.6 1"/>
                
                <!-- shoulder, pitch -->
                <body name="shoulder" pos="0 0 0.12">
                    <joint name="shoulder_link" type="hinge" pos="0 0 0" axis="0 -1 0" range="-120 120"/>
                    <geom type="box" size=".02 .01 .12" pos="0 0 0.12" rgba="0.75 0.75 0.75 1"/>
                    <geom type="cylinder" size="0.04 0.016" mass="0.5" pos="0 0 0" euler="90 0 0" rgba="0.6 0.6 0.6 1"/>
                    
                    <!-- upper arm, pitch -->
                    <body name="upper_arm" pos="0 0 0.24">
                        <joint name="upper_arm_link" type="hinge" pos="0 0 0" axis="0 -1 0" range="-120 120"/>
                        <geom type="box" size=".02 .01 .12" mass="0.5" pos="0 0 0.12" rgba="0.75 0.75 0.75 1" contype="0" conaffinity="0"/>
                        <geom type="cylinder" size="0.04 0.016" mass="0.5" pos="0 0 0" euler="90 0 0" rgba="0.6 0.6 0.6 1"/>

                        <!-- forearm, pitch -->
                        <body name="forearm" pos="0 0 0.24">
                            <joint name="forearm_link" type="hinge" pos="0 0 0" axis="0 -1 0" range="-120 120"/>
                            <geom type="box" size=".02 .01 .12" mass="0.5" pos="0 0 0.12" rgba="0.75 0.75 0.75 1" contype="0" conaffinity="0"/>
                            <geom type="cylinder" size="0.04 0.016" mass="0.5" pos="0 0 0" euler="90 0 0" rgba="0.6 0.6 0.6 1"/>

                            <!-- claw, yaw? -->
                            <body name="hand" pos="0 0 0.24">
                                <geom type="sphere" size="0.05" mass="0.5" pos="0 0 0" rgba="0.6 0.6 0.6 1"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="torso_act"      joint="torso_bodylink"  kp="0.5"    kv="0.5"  ctrlrange="-3.5 3.5"/>
        <position name="shoulder_act"   joint="shoulder_link"   kp="1"    kv="0.6" ctrlrange="-2.5 2.5"/>
        <position name="upper_arm_act"  joint="upper_arm_link"  kp="0.5"    kv="0.2"  ctrlrange="-2.5 2.5"/>
        <position name="forearm_act"    joint="forearm_link"    kp="0.3"    kv="0.2" ctrlrange="-2.5 2.5"/>
    </actuator>
</mujoco>