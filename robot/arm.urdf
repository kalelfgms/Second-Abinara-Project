<robot name="arm">

  <material name="light_grey">
    <color rgba="0.75 0.75 0.75 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <link name="world"/>

  <joint name="world_to_baselink" type="fixed">
    <parent link="world"/>
    <child link="baselink"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="baselink">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.008333" ixy="0" ixz="0" iyy="0.008333" iyz="0" izz="0.013333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </collision>
  </link>

  <!-- ============ torso (yaw) ============ -->
  <joint name="torso_bodylink" type="revolute">
    <parent link="baselink"/>
    <child link="torso"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
  </joint>

  <link name="torso">
    <inertial>
      <origin xyz="0 0 0.0194" rpy="0 0 0"/>
      <mass value="0.6684"/>
      <inertia ixx="0.001269" ixy="0" ixz="0" iyy="0.001318" iyz="0" izz="0.000895"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.03 0.12"/></geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.03 0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
  </link>

  <!-- ============ shoulder (pitch) ============ -->
  <joint name="shoulder_link" type="revolute">
    <parent link="torso"/>
    <child link="shoulder"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="10" velocity="2.0"/>
  </joint>

  <link name="shoulder">
    <inertial>
      <origin xyz="0 0 0.0333" rpy="0 0 0"/>
      <mass value="0.692"/>
      <inertia ixx="0.003168" ixy="0" ixz="0" iyy="0.003345" iyz="0" izz="0.000275"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.24"/></geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.032"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.24"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.032"/></geometry>
    </collision>
  </link>

  <!-- ============ upper arm (pitch) ============ -->
  <joint name="upper_arm_link" type="revolute">
    <parent link="shoulder"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="10" velocity="2.0"/>
  </joint>

  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.006259" ixy="0" ixz="0" iyy="0.006467" iyz="0" izz="0.000326"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.24"/></geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.032"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- the box had contype=0 conaffinity=0 in MJCF, so only the cap collides -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.032"/></geometry>
    </collision>
  </link>

  <!-- ============ forearm (pitch) ============ -->
  <joint name="forearm_link" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="10" velocity="2.0"/>
  </joint>

  <link name="forearm">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.006259" ixy="0" ixz="0" iyy="0.006467" iyz="0" izz="0.000326"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.24"/></geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.032"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.032"/></geometry>
    </collision>
  </link>

  <!-- ============ hand (no joint in MJCF, so fixed) ============ -->
  <joint name="forearm_to_hand" type="fixed">
    <parent link="forearm"/>
    <child link="hand"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
  </joint>

  <link name="hand">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>

</robot>