<robot name="arm">
    <material name="light_gray"><color rgba="0.75 0.75 0.75 1"/></material>
    <material name="dark_gray"><color rgba="0.6 0.6 0.6 1"/></material>

    <link name="world"/>
    <joint name="world_to_baselink" type="fixed">
        <parent link="world"/>
        <child link="baselink"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- base -->
    <link name="baselink">
        <visual>
            <geometry><box size="0.2 0.2 0.1"/></geometry>
            <material name="light_gray"/>
        </visual>
        <inertial>
            <mass value="4.0"/>
            <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.03"/>
        </inertial>
    </link>

    <!-- torso, yaw -->
    <joint name="torso_bodylink" type="revolute">
        <parent link="baselink"/>
        <child link="torso"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="2"/>
    </joint>
    <link name="torso">
        <visual>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <geometry><box size="0.06 0.03 0.12"/></geometry>
            <material name="light_gray"/>
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.06" length="0.06"/></geometry>
            <material name="dark_gray"/>
        </visual>
        <inertial>
            <origin xyz="0 0 0.0145" rpy="0 0 0"/>
            <mass value="0.9"/>
            <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
        </inertial>
    </link>

    <!-- shoulder, pitch -->
    <joint name="shoulder_link" type="revolute">
        <parent link="torso"/>
        <child link="shoulder"/>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.1" upper="2.1" effort="10" velocity="2"/>
    </joint>
    <link name="shoulder">
        <visual>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry><box size="0.04 0.02 0.24"/></geometry>
            <material name="light_gray"/>
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.04" length="0.032"/></geometry>
            <material name="dark_gray"/>
        </visual>
        <inertial>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
        </inertial>
    </link>

    <!-- upper arm, pitch -->
    <joint name="upper_arm_link" type="revolute">
        <parent link="shoulder"/>
        <child link="upper_arm"/>
        <origin xyz="0 0 0.24" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.1" upper="2.1" effort="10" velocity="2"/>
    </joint>
    <link name="upper_arm">
        <visual>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry><box size="0.04 0.02 0.24"/></geometry>
            <material name="light_gray"/>
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.04" length="0.032"/></geometry>
            <material name="dark_gray"/>
        </visual>
        <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
        </inertial>
    </link>

    <!-- forearm, pitch -->
    <joint name="forearm_link" type="revolute">
        <parent link="upper_arm"/>
        <child link="forearm"/>
        <origin xyz="0 0 0.24" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.1" upper="2.1" effort="10" velocity="2"/>
    </joint>
    <link name="forearm">
        <visual>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry><box size="0.04 0.02 0.24"/></geometry>
            <material name="light_gray"/>
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.04" length="0.032"/></geometry>
            <material name="dark_gray"/>
        </visual>
        <inertial>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
        </inertial>
    </link>

    <!-- hand -->
    <joint name="forearm_to_hand" type="fixed">
        <parent link="forearm"/>
        <child link="hand"/>
        <origin xyz="0 0 0.24" rpy="0 0 0"/>
    </joint>
    <link name="hand">
        <visual>
            <geometry><sphere radius="0.05"/></geometry>
            <material name="dark_gray"/>
        </visual>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
        </inertial>
    </link>
</robot>